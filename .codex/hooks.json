{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/local-path-lint.py --hook",
            "statusMessage": "ローカルパス検査"
          },
          {
            "type": "command",
            "command": "python3 scripts/identity-lint.py --hook",
            "statusMessage": "識別子検査"
          }
        ]
      }
    ]
  }
}
